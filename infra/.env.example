# Copy to infra/.env to override the defaults of docker-compose.yml.
# Development-only values: never put real credentials here.

# PostgreSQL
POSTGRES_PORT=5432
POSTGRES_DB=spendly
POSTGRES_USER=spendly
POSTGRES_PASSWORD=spendly

# Keycloak (admin console: http://localhost:8180/admin)
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Mailpit (SMTP + web UI)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# MinIO (S3 API + object browser); the password needs at least 8 characters
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=spendly
MINIO_ROOT_PASSWORD=spendly-secret
MINIO_BUCKET=receipts
